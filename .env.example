# ---------------------------------------------------------------------------
# pickup-counter — environment configuration template
#
# Copy to `.env` and adjust for your machine. `.env` is git-ignored and must
# never be committed. Every value below is a PLACEHOLDER or a local-development
# default — none of them is a real secret. Real secrets are supplied out of
# band (password manager, secrets manager) and differ per environment.
# ---------------------------------------------------------------------------

# --- PostgreSQL ------------------------------------------------------------

# Application database (Docker Compose default credentials for local dev only).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/pickup_counter

# Separate database used by integration tests. MUST be different from
# DATABASE_URL: tests create and destroy data aggressively.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/pickup_counter_test

# --- API -------------------------------------------------------------------

# Port the Express API listens on.
API_PORT=3001

# development | test | production
NODE_ENV=development

# How long an unpaid order holds its stock, in seconds. Assignment default: 120.
# Changing this changes order expiry behavior everywhere (API + tests).
HOLD_TTL_SECONDS=120

# --- Payments webhook ------------------------------------------------------

# Shared secret used to compute and verify the X-Signature header
# (HMAC-SHA256 over the exact raw request body).
# Local placeholder only. REPLACE for any shared/staging/production deploy,
# use a high-entropy value, and keep it identical on the payment-provider side.
WEBHOOK_SECRET=change-me-local-dev-secret

# --- Frontend (apps/web, Vite) ---------------------------------------------

# Base URL the browser uses to reach the API.
VITE_API_BASE_URL=http://localhost:3001
