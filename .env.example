# ---------------------------------------------------------------------------
# pickup-counter — environment configuration template
#
# Copy to `.env` and adjust for your machine. `.env` is git-ignored and must
# never be committed. Every value below is a PLACEHOLDER or a local-development
# default — none of them is a real secret. Real secrets are supplied out of
# band (password manager, secrets manager) and differ per environment.
# ---------------------------------------------------------------------------

# --- PostgreSQL ------------------------------------------------------------

# Application database (Docker Compose default credentials for local dev only).
# NOTE: `localhost` is correct when running the API on the host (npm run dev).
# Inside `docker compose` the database host is the service name `db`, e.g.
# postgres://postgres:postgres@db:5432/pickup_counter — the compose file
# builds that URL itself; you only need the localhost form for host runs.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/pickup_counter

# Separate database used by integration tests. MUST be different from
# DATABASE_URL: tests create and destroy data aggressively (they DROP SCHEMA).
# Docker Compose creates this database automatically on first boot
# (docker/init/01-create-test-db.sql).
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/pickup_counter_test

# Credentials and port used by the `db` service in docker-compose.yml.
# Local-dev defaults only — replace for anything shared.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=pickup_counter
POSTGRES_PORT=5432

# --- API -------------------------------------------------------------------

# Port the Express API listens on.
API_PORT=3001

# development | test | production
NODE_ENV=development

# How long an unpaid order holds its stock, in seconds. Assignment default: 120.
# Changing this changes order expiry behavior everywhere (API + tests).
HOLD_TTL_SECONDS=120

# --- Payments webhook ------------------------------------------------------

# Shared secret used to compute and verify the X-Signature header
# (HMAC-SHA256 over the exact raw request body).
# Local-development placeholder only. REPLACE for any shared/staging/production
# deploy with a high-entropy value, and keep it identical on the
# payment-provider side. It must be >= 16 characters and must not be the
# retired placeholder `change-me-local-dev-secret`: the API and migration
# containers run with NODE_ENV=production under Docker Compose and refuse to
# boot with that value (WEBHOOK_SECRET is validated, never echoed).
WEBHOOK_SECRET=compose-local-dev-webhook-secret

# --- Frontend (apps/web, Vite) ---------------------------------------------

# Base URL the browser uses to reach the API.
VITE_API_BASE_URL=http://localhost:3001

# Host port the built web UI binds on under Docker Compose (nginx in the
# `web` container proxies /health /products /orders /payments to the api
# service, so the browser stays same-origin).
WEB_PORT=5173
